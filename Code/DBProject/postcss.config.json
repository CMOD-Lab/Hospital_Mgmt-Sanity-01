{
  "plugins": {
    "cssnano": {
      "preset": [
        "default",
        {
          "discardComments": { "removeAll": true },
          "normalizeWhitespace": true,
          "minifySelectors": true,
          "minifyParams": true,
          "reduceIdents": false,
          "mergeRules": true,
          "mergeLonghand": true
        }
      ]
    }
  }
}
