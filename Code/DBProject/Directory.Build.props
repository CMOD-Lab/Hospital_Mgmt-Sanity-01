<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Build.props
  Injected to resolve MSB3644: The reference assemblies for .NETFramework,Version=v4.8
  were not found. This file adds the Microsoft.NETFramework.ReferenceAssemblies NuGet
  package which provides .NET Framework reference assemblies on non-Windows (Linux) build
  environments such as the .NET SDK 10.0 container used in CI/CD pipelines.
-->
<Project>
  <PropertyGroup>
    <!-- Enable PackageReference restore style for old-style (non-SDK) projects on Linux -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <ItemGroup>
    <!-- Provides .NET Framework reference assemblies on Linux/non-Windows build agents -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
