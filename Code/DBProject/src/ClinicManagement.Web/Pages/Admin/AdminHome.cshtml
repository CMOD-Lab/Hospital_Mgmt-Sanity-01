@page
@model ClinicManagement.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <h2 class="mb-4"><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x mb-2"></i>
                    <h3>@Model.Stats.TotalPatients</h3>
                    <p class="mb-0">Total Patients</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-user-md fa-3x mb-2"></i>
                    <h3>@Model.Stats.TotalDoctors</h3>
                    <p class="mb-0">Active Doctors</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-hospital fa-3x mb-2"></i>
                    <h3>@Model.Stats.DepartmentStats.Count()</h3>
                    <p class="mb-0">Departments</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <i class="fas fa-dollar-sign fa-3x mb-2"></i>
                    <h3>@Model.Stats.TotalIncome.ToString("C")</h3>
                    <p class="mb-0">Total Income</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-hospital me-2"></i>Departments</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <thead><tr><th>Department</th><th>Doctors</th></tr></thead>
                        <tbody>
                            @foreach (var dept in Model.Stats.DepartmentStats)
                            {
                                <tr>
                                    <td>@dept.DeptName</td>
                                    <td><span class="badge bg-primary">@dept.DoctorCount</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row g-3">
                <div class="col-6">
                    <a href="/Admin/ManageClinic" class="card text-center text-decoration-none shadow h-100">
                        <div class="card-body text-primary">
                            <i class="fas fa-clinic-medical fa-3x mb-2"></i>
                            <p class="mb-0 fw-bold">Manage Clinic</p>
                        </div>
                    </a>
                </div>
                <div class="col-6">
                    <a href="/Admin/DoctorRegistrationForm" class="card text-center text-decoration-none shadow h-100">
                        <div class="card-body text-success">
                            <i class="fas fa-user-plus fa-3x mb-2"></i>
                            <p class="mb-0 fw-bold">Add Doctor</p>
                        </div>
                    </a>
                </div>
                <div class="col-6">
                    <a href="/Admin/AddStaff" class="card text-center text-decoration-none shadow h-100">
                        <div class="card-body text-info">
                            <i class="fas fa-users fa-3x mb-2"></i>
                            <p class="mb-0 fw-bold">Add Staff</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
