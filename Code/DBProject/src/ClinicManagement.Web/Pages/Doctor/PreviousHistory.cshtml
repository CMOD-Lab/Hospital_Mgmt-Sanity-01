@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="text-info mb-4"><i class="fas fa-notes-medical me-2"></i>Previous Patient History</h2>

    @if (Model.History.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow">
                <thead class="table-info">
                    <tr>
                        <th>#</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.History)
                    {
                        <tr>
                            <td>@h.AppointId</td>
                            <td>@h.PatientName</td>
                            <td>@h.Date?.ToString("yyyy-MM-dd")</td>
                            <td>@h.Disease</td>
                            <td>@h.Progress</td>
                            <td>@h.Prescription</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No previous history found.</div>
    }
</div>
