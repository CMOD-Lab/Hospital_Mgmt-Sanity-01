@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Bills";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="text-info mb-4"><i class="fas fa-file-invoice me-2"></i>Today's Appointments - Billing</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.Success ? "alert-success" : "alert-danger")">@Model.Message</div>
    }

    @if (Model.Appointments.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow">
                <thead class="table-info">
                    <tr>
                        <th>#</th>
                        <th>Patient</th>
                        <th>Time</th>
                        <th>Disease</th>
                        <th>Prescription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.Appointments)
                    {
                        <tr>
                            <td>@appt.AppointId</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Timings</td>
                            <td>@appt.Disease</td>
                            <td>@appt.Prescription</td>
                            <td>
                                <a href="/Doctor/HistoryUpdate?appointmentId=@appt.AppointId" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit me-1"></i>Update
                                </a>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                    <button type="submit" asp-page-handler="Paid" class="btn btn-sm btn-success">
                                        <i class="fas fa-check me-1"></i>Paid
                                    </button>
                                    <button type="submit" asp-page-handler="Unpaid" class="btn btn-sm btn-warning">
                                        <i class="fas fa-times me-1"></i>Unpaid
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No appointments for today.</div>
    }
</div>
