@page
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update History";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="text-info mb-4"><i class="fas fa-edit me-2"></i>Update Patient History</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.Success ? "alert-success" : "alert-danger")">@Model.Message</div>
    }

    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Appointment #@Model.AppointmentId</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                <div class="mb-3">
                    <label class="form-label">Disease</label>
                    <input type="text" name="disease" value="@Model.Disease" class="form-control" placeholder="Enter disease" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Progress</label>
                    <textarea name="progress" class="form-control" rows="3" placeholder="Enter progress notes">@Model.Progress</textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Prescription</label>
                    <textarea name="prescription" class="form-control" rows="3" placeholder="Enter prescription">@Model.Prescription</textarea>
                </div>
                <button type="submit" class="btn btn-info text-white">
                    <i class="fas fa-save me-2"></i>Update
                </button>
                <a href="/Doctor/Bill" class="btn btn-secondary ms-2">
                    <i class="fas fa-arrow-left me-2"></i>Back
                </a>
            </form>
        </div>
    </div>
</div>
