@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="text-info mb-4"><i class="fas fa-clock me-2"></i>Pending Appointments</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.Success ? "alert-success" : "alert-danger")">@Model.Message</div>
    }

    @if (Model.Appointments.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow">
                <thead class="table-info">
                    <tr>
                        <th>#</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.Appointments)
                    {
                        <tr>
                            <td>@appt.AppointId</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Date?.ToString("yyyy-MM-dd")</td>
                            <td>@appt.Timings</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                    <button type="submit" asp-page-handler="Approve" class="btn btn-sm btn-success">
                                        <i class="fas fa-check me-1"></i>Approve
                                    </button>
                                    <button type="submit" asp-page-handler="Reject" class="btn btn-sm btn-danger">
                                        <i class="fas fa-times me-1"></i>Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No pending appointments.</div>
    }
</div>
