@page
@model ClinicManagement.Web.Pages.Patient.TakeAppointmentModel
@{
    ViewData["Title"] = "Take Appointment";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="text-success mb-4"><i class="fas fa-calendar-plus me-2"></i>Take Appointment</h2>

    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Select Department</h5>
        </div>
        <div class="card-body">
            <form method="get">
                <div class="row align-items-end">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Department</label>
                        <select name="deptName" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Select Department --</option>
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.DeptName" selected="@(dept.DeptName == Model.SelectedDept)">
                                    @dept.DeptName
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SelectedDept) && Model.Doctors.Any())
    {
        <div class="card shadow mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Doctors in @Model.SelectedDept</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-info">
                            <tr>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.Doctors)
                            {
                                <tr>
                                    <td>@doc.Name</td>
                                    <td>@doc.DepartmentName</td>
                                    <td>
                                        <a href="/Patient/AppointmentTaker?doctorId=@doc.DoctorId" class="btn btn-sm btn-success">
                                            <i class="fas fa-calendar-plus me-1"></i>Book
                                        </a>
                                        <a href="/Patient/DoctorProfile?doctorId=@doc.DoctorId" class="btn btn-sm btn-info">
                                            <i class="fas fa-user-md me-1"></i>Profile
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
