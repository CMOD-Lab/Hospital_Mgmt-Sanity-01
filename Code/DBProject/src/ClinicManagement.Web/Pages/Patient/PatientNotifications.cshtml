@page
@model ClinicManagement.Web.Pages.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="text-success mb-4"><i class="fas fa-bell me-2"></i>Notifications</h2>

    @if (Model.Notification != null)
    {
        <div class="card shadow border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-bell me-2"></i>Appointment Update</h5>
            </div>
            <div class="card-body">
                <p class="fs-5">
                    Your appointment with <strong>Dr. @Model.Notification.DoctorName</strong>
                    at <strong>@Model.Notification.Timings</strong> has been
                    <span class="badge @(Model.Notification.AppointmentStatus == 1 ? "bg-success" : "bg-danger")">
                        @(Model.Notification.AppointmentStatus == 1 ? "Approved" : "Rejected")
                    </span>
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No new notifications.
        </div>
    }
</div>
