@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="text-success mb-4"><i class="fas fa-history me-2"></i>Treatment History</h2>

    @if (Model.Treatments.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow">
                <thead class="table-success">
                    <tr>
                        <th>#</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Treatments)
                    {
                        <tr>
                            <td>@t.AppointId</td>
                            <td>@t.DoctorName</td>
                            <td>@t.Date?.ToString("yyyy-MM-dd")</td>
                            <td>@t.Disease</td>
                            <td>@t.Progress</td>
                            <td>@t.Prescription</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No treatment history found.</div>
    }
</div>
