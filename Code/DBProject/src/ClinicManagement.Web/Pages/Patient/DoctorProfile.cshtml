@page
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="text-success mb-4"><i class="fas fa-user-md me-2"></i>Doctor Profile</h2>

    @if (Model.Doctor != null)
    {
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Dr. @Model.Doctor.Name</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr><th>Name:</th><td>@Model.Doctor.Name</td></tr>
                            <tr><th>Phone:</th><td>@Model.Doctor.Phone</td></tr>
                            <tr><th>Gender:</th><td>@(Model.Doctor.Gender == "M" ? "Male" : "Female")</td></tr>
                            <tr><th>Age:</th><td>@Model.Doctor.Age years</td></tr>
                            <tr><th>Department:</th><td>@Model.Doctor.DepartmentName</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr><th>Qualification:</th><td>@Model.Doctor.Qualification</td></tr>
                            <tr><th>Specialization:</th><td>@Model.Doctor.Specialization</td></tr>
                            <tr><th>Experience:</th><td>@Model.Doctor.WorkExperience years</td></tr>
                            <tr><th>Charges/Visit:</th><td>@Model.Doctor.ChargesPerVisit.ToString("C")</td></tr>
                            <tr><th>Repute Index:</th><td>@Model.Doctor.ReputeIndex.ToString("F1")</td></tr>
                            <tr><th>Patients Treated:</th><td>@Model.Doctor.PatientsTreated</td></tr>
                        </table>
                    </div>
                </div>
                <a href="/Patient/AppointmentTaker?doctorId=@Model.Doctor.DoctorId" class="btn btn-success">
                    <i class="fas fa-calendar-plus me-2"></i>Book Appointment
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Doctor not found.</div>
    }
</div>
