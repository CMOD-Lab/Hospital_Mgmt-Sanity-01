<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433

  cr-dotnet-0045: Session State Provider
  In-process (InProc) HttpSessionState has been replaced with Amazon ElastiCache
  for Redis distributed session store via ASP.NET Core ISession / IDistributedCache.
  The Redis-backed session is registered in Session/RedisSessionConfiguration.cs using
  AddRedisDistributedSession() which reads the following environment variables at runtime:
    REDIS_CONNECTION_STRING  – ElastiCache Redis primary endpoint
                               e.g. "my-cluster.abc123.ng.0001.use1.cache.amazonaws.com:6379"
    SESSION_TIMEOUT_MINUTES  – idle session timeout in minutes (default: 30)
  Set these variables in your ECS task definition, Elastic Beanstalk environment
  properties, or AWS Systems Manager Parameter Store / Secrets Manager.

  cr-dotnet-1041: Content Security Policy Headers
  CSP headers are injected by the ContentSecurityPolicyModule HttpModule registered
  below in both system.web/httpModules (Classic pipeline) and
  system.webServer/modules (Integrated pipeline / AWS Elastic Beanstalk).
  The CSP directives can be overridden per environment via the following environment
  variables (set in ECS task definition, Elastic Beanstalk environment properties,
  or AWS Systems Manager Parameter Store / Secrets Manager):
    CSP_DEFAULT_SRC   – default-src directive  (default: 'self')
    CSP_SCRIPT_SRC    – script-src directive   (default: 'self' 'unsafe-inline')
    CSP_STYLE_SRC     – style-src directive    (default: 'self' 'unsafe-inline')
    CSP_IMG_SRC       – img-src directive      (default: 'self' data:)
    CSP_FONT_SRC      – font-src directive     (default: 'self')
    CSP_CONNECT_SRC   – connect-src directive  (default: 'self')
    CSP_FRAME_SRC     – frame-src directive    (default: 'none')
    CSP_OBJECT_SRC    – object-src directive   (default: 'none')
    CSP_BASE_URI      – base-uri directive     (default: 'self')
    CSP_FORM_ACTION   – form-action directive  (default: 'self')
    CSP_REPORT_ONLY   – set to "true" to use Report-Only mode (default: false)
  AWS WAF managed rules (AWSManagedRulesCommonRuleSet) should be enabled on the
  associated CloudFront distribution or Application Load Balancer for additional
  XSS protection in multi-tenant cloud environments.
  -->
<configuration>

  <appSettings>
    <!--
      cr-dotnet-0045: Redis connection string fallback for local development.
      In production (AWS ECS / Elastic Beanstalk), set the REDIS_CONNECTION_STRING
      environment variable to the Amazon ElastiCache for Redis primary endpoint.
      Example: my-cluster.abc123.ng.0001.use1.cache.amazonaws.com:6379
    -->
    <add key="Redis:ConnectionString" value="" />
    <!--
      cr-dotnet-0045: Session idle timeout in minutes (default: 30).
      Override with SESSION_TIMEOUT_MINUTES environment variable in production.
    -->
    <add key="Session:TimeoutMinutes" value="30" />
  </appSettings>

  <connectionStrings>
    <add name="sqlCon1" connectionString="Data Source=.\SQLEXPRESS; Initial Catalog=DBProject; Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.5.2"/>
    <httpRuntime targetFramework="4.5.2"/>
    <!--
      cr-dotnet-0045: InProc sessionState element removed.
      Session state is now managed by Amazon ElastiCache for Redis via
      ASP.NET Core ISession middleware (IDistributedCache-backed).
      See Session/RedisSessionConfiguration.cs for registration details.
    -->
    <httpModules>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"/>
      <!--
        cr-dotnet-1041: Register ContentSecurityPolicyModule for IIS Classic pipeline mode.
        Injects Content-Security-Policy headers on every response to satisfy SOC2
        and penetration test compliance requirements in AWS cloud environments.
      -->
      <add name="ContentSecurityPolicyModule" type="DBProject.Security.ContentSecurityPolicyModule, DBProject"/>
    </httpModules>
  </system.web>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:6 /nowarn:1659;1699;1701"/>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb"
        type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
        warningLevel="4" compilerOptions="/langversion:14 /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+"/>
    </compilers>
  </system.codedom>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules>
      <remove name="ApplicationInsightsWebTracking"/>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web"
        preCondition="managedHandler"/>
      <!--
        cr-dotnet-1041: Register ContentSecurityPolicyModule for IIS Integrated pipeline mode.
        This entry covers AWS Elastic Beanstalk (IIS on Windows) and any IIS-hosted
        deployment using the Integrated pipeline.  The module runs for all managed
        requests (preCondition="managedHandler") and appends CSP + complementary
        security headers (X-Content-Type-Options, X-Frame-Options, X-XSS-Protection,
        Referrer-Policy) to every response.
      -->
      <remove name="ContentSecurityPolicyModule"/>
      <add name="ContentSecurityPolicyModule"
           type="DBProject.Security.ContentSecurityPolicyModule, DBProject"
           preCondition="managedHandler"/>
    </modules>
  </system.webServer>
</configuration>
