# =============================================================
# .dockerignore for Clinic Management System
# =============================================================
#
# Rule: cz-dotnet-1040 - Unoptimized Web Forms Container Image Size
# Remediation: Exclude source code, PDB files, temp files, and build
#              artifacts from the Docker build context to prevent them
#              from bloating the Windows container image deployed to EKS.
#              Multi-stage Dockerfile ensures only the published web
#              application artifacts reach the final runtime image.
#
# Rule: cz-css-1011 - SCSS/LESS Source Files in Production Container
# Remediation: Exclude preprocessor source files from runtime image.
#              SCSS/LESS are compiled to CSS during the multi-stage
#              build (Stage 1: css-minify) and only compiled CSS
#              artifacts are copied into the final runtime image.
# =============================================================

# ---------------------------------------------------------------
# cz-dotnet-1040: Source code files - excluded from final image
# Source code has no place in a production container image;
# only the compiled/published output is needed at runtime.
# ---------------------------------------------------------------
**/*.cs
**/*.vb
**/*.aspx
**/*.ascx
**/*.master
**/*.ashx
**/*.asmx
**/*.svc
**/*.cshtml
**/*.vbhtml
**/*.resx
**/*.Designer.cs
**/*.designer.cs

# ---------------------------------------------------------------
# cz-dotnet-1040: PDB (Program Database) debug symbol files
# PDB files are unnecessary in production containers and bloat
# the Windows container image (already large by default).
# ---------------------------------------------------------------
**/*.pdb
**/*.mdb

# ---------------------------------------------------------------
# cz-dotnet-1040: Temporary and intermediate build files
# MSBuild intermediate output, cache files, and temp artifacts
# that serve no purpose in the production container image.
# ---------------------------------------------------------------
obj/
bin/Debug/
bin/Release/
*.cache
*.tmp
*.temp
**/*.FileListAbsolute.txt
**/*.CoreCompileInputs.cache
**/*.AssemblyReference.cache
**/*.ResolveAssemblyReference.cache
**/*.CopyComplete
TemporaryGeneratedFile_*.cs

# ---------------------------------------------------------------
# cz-dotnet-1040: Visual Studio / IDE files
# Development environment files that must not be shipped to
# production container images.
# ---------------------------------------------------------------
*.user
*.suo
*.sln.docstates
.vs/
*.DotSettings
*.DotSettings.user
*.vspx
*.vspscc
*.vssscc
*.pidb
*.userprefs

# ---------------------------------------------------------------
# cz-dotnet-1040: NuGet package cache
# Packages are restored during the build stage; the cache
# directory must not be copied into the runtime image.
# ---------------------------------------------------------------
packages/
*.nupkg
*.nuspec

# ---------------------------------------------------------------
# cz-dotnet-1040: Test projects and test output
# Unit/integration test assemblies and results have no place
# in a production container image.
# ---------------------------------------------------------------
**/*Tests*/
**/*Test*/
TestResults/
*.trx
*.coverage
*.coveragexml

# ---------------------------------------------------------------
# cz-dotnet-1040: Documentation and non-runtime assets
# README, PDF schemas, SQL scripts, and image assets used only
# for documentation are not needed in the runtime container.
# ---------------------------------------------------------------
*.md
*.pdf
*.sql
*.txt
*.log
*.bak

# ---------------------------------------------------------------
# cz-css-1011: SCSS/LESS preprocessor source files
# Excluded from the Docker build context to prevent them from
# being included in the production container image.
# SCSS/LESS are compiled to CSS during Stage 1 (css-minify) of
# the multi-stage build; only compiled CSS artifacts are copied
# into the final runtime image.
