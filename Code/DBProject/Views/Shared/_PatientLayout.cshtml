@*
    _PatientLayout.cshtml
    ASP.NET Core MVC Razor Layout – replaces PatientMaster.Master (cr-dotnet-0026).

    Migration changes from Web Forms Master Page:
      <%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PatientMaster.master.cs"
                 Inherits="DBProject.PatientMaster" %>
              → (no directive; standard Razor layout)
      <head runat="server">                      → <head> (plain HTML)
      <form id="form1" runat="server">           → removed (ASP.NET Core uses tag helpers)
      <asp:ContentPlaceHolder ID="head" />       → @RenderSection("head", required: false)
      <asp:ContentPlaceHolder ID="ContentPlaceHolder1" /> → @RenderBody()
      Navigation .aspx hrefs                     → MVC route URLs
*@
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <!-- Google Fonts -->
    <link href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700|Lato:400,100,300,700,900' rel='stylesheet' type='text/css' />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"
          integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u"
          crossorigin="anonymous" />

    <!-- Patient Style -->
    <link rel="stylesheet" href="/assets/css/patient-style.css" />

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.4/jquery.min.js"></script>

    <!-- Footer Styling -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="keywords" content="footer, address, phone, icons" />

    <link rel="stylesheet" href="/assets/css/demo.css" />
    <link rel="stylesheet" href="/assets/css/footer-distributed-with-address-and-phones.css" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" />
    <link href="https://fonts.googleapis.com/css?family=Cookie" rel="stylesheet" type="text/css" />

    @* Replaces <asp:ContentPlaceHolder ID="head" runat="server"> *@
    @RenderSection("head", required: false)
</head>

<body>
    <div>
        <!-- Navigation Bar – replaces inline nav in PatientMaster.Master -->
        <nav class="navbar navbar-inverse">
            <div class="container-fluid" style="background-color:#4c4f51">

                <ul class="nav navbar-nav navbar-right">
                    @* /SignUp.aspx → /Account/Logout *@
                    <li><a href="/Account/Logout"><span class="glyphicon glyphicon-log-in"></span> Log Out</a></li>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    @* PatientFeedback.aspx → /PatientFeedback *@
                    <li><a href="/PatientFeedback"><span class="glyphicon glyphicon-thumbs-up"></span> Feedback</a></li>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    @* TreatmentHistory.aspx → /TreatmentHistory *@
                    <li><a href="/TreatmentHistory"><span class="glyphicon glyphicon-info-sign"></span> Treatment History</a></li>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    @* BillsHistory.aspx → /BillsHistory *@
                    <li><a href="/BillsHistory"><span class="glyphicon glyphicon-usd"></span> Bills History</a></li>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    @* TakeAppointment.aspx → /TakeAppointment *@
                    <li><a href="/TakeAppointment"><span class="glyphicon glyphicon-plus"></span> Take Appointment</a></li>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    @* CurrentAppointment.aspx → /CurrentAppointment *@
                    <li><a href="/CurrentAppointment"><span class="glyphicon glyphicon-search"></span> Current Appointment</a></li>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    @* PatientNotifications.aspx → /PatientNotifications *@
                    <li><a href="/PatientNotifications"><span class="glyphicon glyphicon-flag"></span> Notifications</a></li>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    @* PatientHome.aspx → /PatientHome *@
                    <li><a href="/PatientHome"><span class="glyphicon glyphicon-home"></span> Home</a></li>
                </ul>

            </div>
        </nav>
        <!-- Navigation Bar ends here -->

        @* Replaces <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"> *@
        @RenderBody()

    </div>

    <!-- Footer -->
    <footer class="footer-distributed">
        <div class="footer-left">
            <h3>MedicX<span>4</span></h3>
            <p class="footer-company-name">MedicX4 Health Care &copy; 2017</p>
        </div>

        <div class="footer-center">
            <div>
                <i class="fa fa-map-marker"></i>
                <p><span>Milaad St Block B</span> Faisal Town, Lahore</p>
            </div>
            <div>
                <i class="fa fa-phone"></i>
                <p>0322 - 7561001</p>
            </div>
            <div>
                <i class="fa fa-envelope"></i>
                <p><a href="mailto:support@medicx4.com">support@medicx4.com</a></p>
            </div>
        </div>

        <div class="footer-right">
            <p class="footer-company-about">
                <span>About the company</span>
                Our mission is to provide quality health services to all in a comfortable and cozy environment.
                The clinic primarily offers consultations and is not equipped to take emergencies.
            </p>
            <div class="footer-icons">
                <a href="#"><i class="fa fa-facebook"></i></a>
            </div>
        </div>
    </footer>
    <!-- Footer ends here -->
</body>
</html>
