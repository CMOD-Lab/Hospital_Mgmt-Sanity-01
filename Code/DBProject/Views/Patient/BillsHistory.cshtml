@*
    Views/Patient/BillsHistory.cshtml
    ASP.NET Core MVC Razor View – replaces BillsHistory.aspx (cr-dotnet-0026).

    Migration changes from Web Forms:
      Line 1: <%@ Page Title="" Language="C#" MasterPageFile="~/Patient/PatientMaster.Master"
                       AutoEventWireup="true" CodeBehind="BillsHistory.aspx.cs"
                       Inherits="DBProject.BillsHistory" %>
              → @{ Layout = "~/Views/Shared/_PatientLayout.cshtml"; }

      <asp:Content ContentPlaceHolderID="head">  → @section head { ... }
      <asp:Content ContentPlaceHolderID="ContentPlaceHolder1"> → main content block (@RenderBody)

      asp:Label ID="BHistory"                    → @Model.StatusMessage display
      asp:GridView ID="BHistoryGrid"             → HTML table rendered from Model.BillHistoryData
        asp:TemplateField HeaderText="No."       → row-number column (loop index + 1)
        asp:Label ID="lblRowNumber"              → @(i + 1) in table cell

    Code-behind logic moved to Controllers/BillsHistoryController.cs.
*@
@model DBProject.Models.BillsHistoryViewModel

@{
    ViewData["Title"] = "Bills History";
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
}

@section head {
    <title>Bills History</title>
}

<!-- Styling -->
<link rel="stylesheet" href="/assets/css/grid-view.css" />

<h1><strong style="margin:37%">Your Bill(s) History</strong></h1>
<br /><br />

@* Replaces asp:Label ID="BHistory" used for status messages *@
<div>@Model.StatusMessage</div>
<br /><br />

@* Replaces asp:GridView ID="BHistoryGrid" with DataSource/DataBind *@
@if (Model.BillHistoryData != null && Model.BillHistoryData.Rows.Count > 0)
{
    <table class="GridView-d table" cellpadding="4"
           style="width:800px; color:black; border:1px solid #DEDFDE; border-style:none; border-width:1px;">
        <thead style="background-color:#6B696B; color:white; font-weight:bold;">
            <tr>
                @* Replaces asp:TemplateField HeaderText="No." *@
                <th style="width:50px">No.</th>
                @foreach (System.Data.DataColumn col in Model.BillHistoryData.Columns)
                {
                    <th>@col.ColumnName</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.BillHistoryData.Rows.Count; i++)
            {
                var row = Model.BillHistoryData.Rows[i];
                string rowStyle = (i % 2 == 0) ? "background-color:#F7F7DE;" : "background-color:white;";
                <tr style="@rowStyle">
                    @* Replaces asp:Label ID="lblRowNumber" Text='<%# Container.DataItemIndex + 1 %>' *@
                    <td style="width:50px">@(i + 1)</td>
                    @foreach (System.Data.DataColumn col in Model.BillHistoryData.Columns)
                    {
                        <td>@row[col]</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

<br /><br />
