@*
    Views/Doctor/PendingAppointment.cshtml
    ASP.NET Core MVC Razor View – replaces PendingAppointment.aspx (cr-dotnet-0026).

    Migration changes from Web Forms:
      Line 1: <%@ Page Title="" Language="C#" MasterPageFile="~/Doctor/doctormaster.Master"
                       AutoEventWireup="true" CodeBehind="PendingAppointment.aspx.cs"
                       Inherits="doctor.pendingappointment" %>
              → @{ Layout = "~/Views/Shared/_DoctorLayout.cshtml"; }

      <asp:Content ContentPlaceHolderID="head">  → @section head { ... }
      <asp:Content ContentPlaceHolderID="Cp3">   → @section Cp3 { ... }

      asp:GridView ID="pendingappointments"      → HTML table rendered from Model.Appointments
        AutoGenerateSelectButton="True"          → "Approve" form POST to PendingAppointment/Approve
        AutoGenerateDeleteButton="True"          → "Delete" form POST to PendingAppointment/Delete
        OnRowCommand="update_appointment"        → row-level form POST to PendingAppointment/Approve
        OnRowDeleting="Delete_appointment"       → row-level form POST to PendingAppointment/Delete

    Code-behind logic moved to Controllers/PendingAppointmentController.cs.
*@
@model DBProject.Models.PendingAppointmentViewModel

@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

@section head {
    <title>Pending Appointments</title>
}

@section Cp3 {
    <!-- Styling -->
    <link rel="stylesheet" href="/assets/css/grid-view.css" />

    <h1><strong style="margin:25%">Pending Appointments</strong></h1>
    <br /><br />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else
    {
        <div style="margin-left:300px">
            <table class="GridView-d table" cellpadding="4"
                   style="color:black; border:1px solid #DEDFDE; border-style:none; border-width:1px;">
                <thead style="background-color:#6B696B; color:white; font-weight:bold;">
                    <tr>
                        @if (Model.Appointments != null && Model.Appointments.Columns != null)
                        {
                            @foreach (System.Data.DataColumn col in Model.Appointments.Columns)
                            {
                                <th>@col.ColumnName</th>
                            }
                        }
                        <th>Approve</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Appointments != null)
                    {
                        @for (int i = 0; i < Model.Appointments.Rows.Count; i++)
                        {
                            var row = Model.Appointments.Rows[i];
                            <tr style="background-color:#F7F7DE;">
                                @foreach (System.Data.DataColumn col in Model.Appointments.Columns)
                                {
                                    <td>@row[col]</td>
                                }
                                <td>
                                    @* Replaces AutoGenerateSelectButton + OnRowCommand="update_appointment" *@
                                    <form asp-controller="PendingAppointment" asp-action="Approve" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@row[1]" />
                                        <button type="submit" class="btn btn-sm btn-default">Select</button>
                                    </form>
                                </td>
                                <td>
                                    @* Replaces AutoGenerateDeleteButton + OnRowDeleting="Delete_appointment" *@
                                    <form asp-controller="PendingAppointment" asp-action="Delete" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appointmentId" value="@row[1]" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}
