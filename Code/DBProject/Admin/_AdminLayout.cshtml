@* ASP.NET Core Razor Layout for the Admin area.
   This file replaces the Web Forms Admin.Master page.
   Rule cr-dotnet-0026: Web Forms Usage → Migrate to ASP.NET Core MVC/Razor Pages
   
   The <%@ Master %> directive and asp:ContentPlaceHolder controls have been replaced
   with standard Razor Layout constructs: @RenderBody() and @RenderSection().
*@
<!DOCTYPE html>
<html>
<head>
    <!--------------------------------- Styling -------------------------------->

    <!-- Google Fonts -->
    <link href='https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700|Lato:400,100,300,700,900' rel='stylesheet' type='text/css' />

    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"
          integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u"
          crossorigin="anonymous" />

    <!-- Admin Style -->
    <link rel="stylesheet" href="/assets/css/patient-style.css" />

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.4/jquery.min.js"></script>

    <!------------------------------------Styling for Footer-------------------------------------->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="keywords" content="footer, address, phone, icons" />

    <link rel="stylesheet" href="/assets/css/demo.css" />
    <link rel="stylesheet" href="/assets/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="/assets/css/footer-distributed-with-address-and-phones.css" />
    <link rel="stylesheet" href="http://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css" />
    <link href="http://fonts.googleapis.com/css?family=Cookie" rel="stylesheet" type="text/css" />

    <title>@ViewData["Title"] - Admin</title>

    @* Replaces asp:ContentPlaceHolder ID="head" — allows child pages to inject head content *@
    @RenderSection("Head", required: false)
</head>

<body>
    <div>
        <!-- Navigation Bar starts from here -->
        <nav class="navbar navbar-inverse">
            <div class="container-fluid" style="background-color:#4c4f51">
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/SignUp"><span class="glyphicon glyphicon-log-in"></span> Log Out</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/Admin/AddStaff"><span class="glyphicon glyphicon-plus"></span> Add Staff</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/Admin/DoctorRegistrationForm"><span class="glyphicon glyphicon-plus"></span> Add Doctor</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/Admin/ManageClinic"><span class="glyphicon glyphicon-cog"></span> Manage Clinic</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/Admin/AdminHome"><span class="glyphicon glyphicon-home"></span> Home</a></li>
                </ul>
            </div>
        </nav>
        <!-- Navigation Bar ends here -->

        @* Replaces asp:ContentPlaceHolder ID="ContentPlaceHolder1" — main page body *@
        @RenderBody()
    </div>

    <!--- Footer starts here -->
    <footer class="footer-distributed">
        <div class="footer-left">
            <h3>MedicX<span>4</span></h3>
            <p class="footer-company-name">MedicX4 Health Care &copy; 2017</p>
        </div>

        <div class="footer-center">
            <div>
                <i class="fa fa-map-marker"></i>
                <p><span>Milaad St Block B</span> Faisal Town, Lahore</p>
            </div>
            <div>
                <i class="fa fa-phone"></i>
                <p>0322 - 7561001</p>
            </div>
            <div>
                <i class="fa fa-envelope"></i>
                <p><a href="mailto:support@medicx4.com">support@medicx4.com</a></p>
            </div>
        </div>

        <div class="footer-right">
            <p class="footer-company-about">
                <span>About the company</span>
                Our mission is to provide quality health services to all in a comfortable and cozy environment.
                The clinic primarily offers consultations and is not equipped to take emergencies.
            </p>
            <div class="footer-icons">
                <a href="#"><i class="fa fa-facebook"></i></a>
            </div>
        </div>
    </footer>
    <!--- Footer ends here -->

    @* Replaces asp:ContentPlaceHolder ID="ContentPlaceHolder2" — allows child pages to inject scripts *@
    @RenderSection("Scripts", required: false)
</body>
</html>
