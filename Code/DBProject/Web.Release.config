<?xml version="1.0" encoding="utf-8"?>
<!--
  cz-dotnet-0055 REMEDIATION: Web.config XDT build-time transforms have been replaced
  with Kubernetes ConfigMaps and environment variables.

  All environment-specific configuration is now injected at container runtime via
  environment variables or mounted Kubernetes ConfigMap/Secret volumes.

  For production/Release deployments on Kubernetes (EKS/AKS/GKE), inject the
  following environment variables via a Kubernetes Secret or ConfigMap:

    DB_CONNECTION_STRING  - Full ADO.NET connection string (recommended for production), e.g.:
                            "Data Source=<rds-endpoint>;Initial Catalog=DBProject;User Id=<user>;Password=<pass>;"
                         OR use individual components:
    DB_HOST               - SQL Server host (e.g. mydb.cluster.rds.amazonaws.com)
    DB_NAME               - Database name (e.g. DBProject)
    DB_USER               - SQL login username
    DB_PASSWORD           - SQL login password (inject via Kubernetes Secret)

    REDIS_HOST            - ElastiCache Redis endpoint
    REDIS_PORT            - Redis port (default: 6379)
    REDIS_ACCESS_KEY      - Redis auth token (inject via Kubernetes Secret)

  Example Kubernetes Secret manifest:
    apiVersion: v1
    kind: Secret
    metadata:
      name: hospital-mgmt-secrets
    type: Opaque
    stringData:
      DB_CONNECTION_STRING: "Data Source=mydb.rds.amazonaws.com;Initial Catalog=DBProject;User Id=sa;Password=secret;"
      REDIS_ACCESS_KEY: "my-redis-auth-token"

  Example Kubernetes ConfigMap manifest:
    apiVersion: v1
    kind: ConfigMap
    metadata:
      name: hospital-mgmt-config
    data:
      REDIS_HOST: "my-cluster.abc123.ng.0001.use1.cache.amazonaws.com"
      REDIS_PORT: "6379"

  The previous XDT transform:
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  has been removed. The debug attribute in Web.config should be set to false
  at build time or controlled via the ASPNET_ENVIRONMENT variable.

  This file intentionally contains no XDT transforms.
  XDT transforms (xdt:Transform / xdt:Locator) do not work in containerized .NET
  deployments and have been removed per containerization rule cz-dotnet-0055.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
</configuration>
