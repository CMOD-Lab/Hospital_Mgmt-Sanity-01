<?xml version="1.0" encoding="utf-8"?>

<!--
  cz-dotnet-0055: Web.config XDT build-time transforms are NOT supported in containers
  and have been replaced with Kubernetes ConfigMap / Secret environment variable injection.

  Previously this file used xdt:Transform="SetAttributes" to override the connection
  string at build time for Release deployments. That approach does not work with the
  .NET Core / container configuration system.

  MIGRATION GUIDE:
  - Set DB_CONNECTION_STRING as a Kubernetes Secret environment variable in your
    deployment manifest, e.g.:
        env:
          - name: DB_CONNECTION_STRING
            valueFrom:
              secretKeyRef:
                name: hospital-mgmt-secrets
                key: db-connection-string
  - The application reads this variable first (see DAL/myDAL.cs line 18).
  - The <connectionStrings> entry in Web.config is retained only as a local fallback.
-->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!--
      cz-dotnet-0055: Removed xdt:Transform="RemoveAttributes(debug)" — build-time
      XDT transforms are not applicable in containerised deployments. Debug mode is
      controlled via the ASPNET_ENV / DOTNET_ENVIRONMENT environment variable instead.
    -->
  </system.web>
</configuration>
