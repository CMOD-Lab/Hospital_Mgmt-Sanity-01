  <!--
    cr-dotnet-0045 / cr-dotnet-0126: Amazon ElastiCache for Redis distributed session provider.
    Replaces IIS in-process (InProc) HttpSessionState / sticky session with Redis-backed
    IDistributedCache, enabling stateless horizontal scaling without sticky session routing.
    Microsoft.Extensions.Caching.StackExchangeRedis: StackExchange.Redis IDistributedCache impl.
    Microsoft.AspNetCore.Session: ASP.NET Core session middleware backed by IDistributedCache.
  -->
  <package id="Microsoft.Extensions.Caching.StackExchangeRedis" version="7.0.0" targetFramework="net452" />
