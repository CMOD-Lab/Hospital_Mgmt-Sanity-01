@page
@model ClinicManagement.Web.Pages.Patient.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-bell me-2"></i>Notifications</h2>
        <hr />
    </div>
</div>

@if (Model.PendingFeedback != null)
{
    <div class="alert alert-warning">
        <h5><i class="fas fa-star me-2"></i>Feedback Pending</h5>
        <p>You have a pending feedback for your appointment with Dr. @Model.PendingFeedback.DoctorName on @Model.PendingFeedback.AppointmentDate.ToString("yyyy-MM-dd").</p>
        <form method="post">
            <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointmentId" />
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-thumbs-up me-1"></i>Submit Feedback
            </button>
        </form>
    </div>
}

@if (Model.CurrentAppointment != null)
{
    <div class="alert alert-success">
        <h5><i class="fas fa-calendar-check me-2"></i>Upcoming Appointment</h5>
        <p>You have an appointment with Dr. @Model.CurrentAppointment.DoctorName at @Model.CurrentAppointment.Timings.</p>
    </div>
}

@if (Model.PendingFeedback == null && Model.CurrentAppointment == null)
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No notifications at this time.
    </div>
}
