@page
@model ClinicManagement.Web.Pages.Patient.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<h2 class="mb-4"><i class="fas fa-bell me-2"></i>Notifications</h2>

@if (Model.PendingFeedback != null)
{
    <div class="alert alert-warning">
        <h5><i class="fas fa-star me-2"></i>Feedback Pending</h5>
        <p>Please provide feedback for your appointment with Dr. @Model.PendingFeedback.DoctorName (@Model.PendingFeedback.Timings)</p>
        <form method="post" asp-page-handler="GiveFeedback">
            <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointmentId" />
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-star me-1"></i>Give Feedback
            </button>
        </form>
    </div>
}

@if (Model.CurrentAppointment != null)
{
    <div class="alert alert-success">
        <h5><i class="fas fa-calendar-check me-2"></i>Upcoming Appointment</h5>
        <p class="mb-0">
            <strong>Doctor:</strong> Dr. @Model.CurrentAppointment.DoctorName |
            <strong>Time:</strong> @Model.CurrentAppointment.Timings
        </p>
    </div>
}

@if (Model.PendingFeedback == null && Model.CurrentAppointment == null)
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No new notifications.
    </div>
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success")">@Model.Message</div>
}
