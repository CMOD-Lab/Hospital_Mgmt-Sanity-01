@page
@model ClinicManagement.Web.Pages.Patient.AppointmentRequestSentModel
@{
    ViewData["Title"] = "Appointment Request Sent";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm">
            <div class="card-body py-5">
                <i class="fas fa-check-circle fa-5x text-success mb-4"></i>
                <h3>Appointment Request Sent!</h3>
                <p class="text-muted">Your appointment request has been submitted successfully. Please wait for the doctor to approve it.</p>
                <a asp-page="/Patient/PatientHome" class="btn btn-primary mt-3">
                    <i class="fas fa-home me-1"></i>Back to Home
                </a>
            </div>
        </div>
    </div>
</div>
