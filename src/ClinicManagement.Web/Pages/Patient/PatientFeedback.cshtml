@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-star me-2"></i>Patient Feedback</h2>
        <hr />
        <a asp-page="/Patient/PatientHome" class="btn btn-secondary mb-3">
            <i class="fas fa-arrow-left me-1"></i>Back to Home
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (Model.PendingFeedback != null)
{
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">Pending Feedback</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.PendingFeedback.DoctorName</p>
            <p><strong>Appointment Time:</strong> @Model.PendingFeedback.Timings</p>
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointmentId" />
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-thumbs-up me-1"></i>Submit Feedback
                </button>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>No pending feedback at this time.
    </div>
}
