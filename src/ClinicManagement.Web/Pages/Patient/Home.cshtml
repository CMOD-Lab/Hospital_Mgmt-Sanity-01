@page
@model ClinicManagement.Web.Pages.Patient.HomeModel
@{
    ViewData["Title"] = "Patient Home";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-user me-2"></i>Welcome, @Model.PatientInfo?.Name</h2>
        <hr />
    </div>
</div>

@if (Model.PatientInfo != null)
{
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-id-card me-2"></i>My Profile</h5>
                </div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.PatientInfo.Name</p>
                    <p><strong>Email:</strong> @Model.PatientInfo.Email</p>
                    <p><strong>Phone:</strong> @Model.PatientInfo.Phone</p>
                    <p><strong>Address:</strong> @Model.PatientInfo.Address</p>
                    <p><strong>Gender:</strong> @(Model.PatientInfo.Gender == "M" ? "Male" : "Female")</p>
                    <p><strong>Age:</strong> @Model.PatientInfo.Age years</p>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-calendar-plus fa-3x text-primary mb-3"></i>
                            <h5>Take Appointment</h5>
                            <a asp-page="/Patient/TakeAppointment" class="btn btn-primary">Book Now</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-calendar-check fa-3x text-success mb-3"></i>
                            <h5>Current Appointment</h5>
                            <a asp-page="/Patient/CurrentAppointment" class="btn btn-success">View</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-file-medical fa-3x text-info mb-3"></i>
                            <h5>Treatment History</h5>
                            <a asp-page="/Patient/TreatmentHistory" class="btn btn-info text-white">View</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-file-invoice-dollar fa-3x text-warning mb-3"></i>
                            <h5>Bills History</h5>
                            <a asp-page="/Patient/BillsHistory" class="btn btn-warning">View</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
