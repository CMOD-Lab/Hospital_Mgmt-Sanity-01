@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-history me-2"></i>Treatment History</h2>
        <hr />
        <a asp-page="/Patient/PatientHome" class="btn btn-secondary mb-3">
            <i class="fas fa-arrow-left me-1"></i>Back to Home
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var treatment in Model.TreatmentHistory)
                    {
                        <tr>
                            <td>@treatment.AppointID</td>
                            <td>@treatment.DoctorName</td>
                            <td>@treatment.Date</td>
                            <td>@treatment.Disease</td>
                            <td>@treatment.Progress</td>
                            <td>@treatment.Prescription</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.TreatmentHistory.Any())
        {
            <div class="alert alert-info">No treatment history found.</div>
        }
    </div>
</div>
