@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
}

<h2 class="mb-4"><i class="fas fa-history me-2"></i>Treatment History</h2>

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Disease</th>
                    <th>Progress</th>
                    <th>Prescription</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.TreatmentHistory)
                {
                    <tr>
                        <td>Dr. @appt.DoctorName</td>
                        <td>@appt.AppointmentDate.ToString("MMM dd, yyyy")</td>
                        <td>@(appt.Disease ?? "-")</td>
                        <td>@(appt.Progress ?? "-")</td>
                        <td>@(appt.Prescription ?? "-")</td>
                    </tr>
                }
                @if (!Model.TreatmentHistory.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No treatment history found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
