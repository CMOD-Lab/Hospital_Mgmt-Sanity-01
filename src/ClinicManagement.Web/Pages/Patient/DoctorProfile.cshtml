@page
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "_PatientLayout";
}

<h2 class="mb-4"><i class="fas fa-user-md text-info me-2"></i>Doctor Profile</h2>

@if (Model.Profile != null)
{
    <div class="card shadow">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 text-center">
                    <i class="fas fa-user-md fa-5x text-info mb-3"></i>
                    <h4>@Model.Profile.Name</h4>
                    <p class="text-muted">@Model.Profile.DeptName</p>
                </div>
                <div class="col-md-9">
                    <table class="table">
                        <tr><th>Phone:</th><td>@Model.Profile.Phone</td></tr>
                        <tr><th>Gender:</th><td>@(Model.Profile.Gender == "M" ? "Male" : "Female")</td></tr>
                        <tr><th>Age:</th><td>@Model.Profile.Age years</td></tr>
                        <tr><th>Qualification:</th><td>@Model.Profile.Qualification</td></tr>
                        <tr><th>Specialization:</th><td>@Model.Profile.Specialization</td></tr>
                        <tr><th>Work Experience:</th><td>@Model.Profile.WorkExperience years</td></tr>
                        <tr><th>Charges Per Visit:</th><td>Rs. @Model.Profile.ChargesPerVisit</td></tr>
                        <tr><th>Repute Index:</th><td>@Model.Profile.ReputeIndex.ToString("F2")</td></tr>
                        <tr><th>Patients Treated:</th><td>@Model.Profile.PatientsTreated</td></tr>
                    </table>
                    <a href="/Patient/TakeAppointment?doctorId=@Model.Profile.DoctorId" class="btn btn-success">
                        <i class="fas fa-calendar-plus me-2"></i>Book Appointment
                    </a>
                    <a href="/Patient/ViewDoctors" class="btn btn-secondary ms-2">Back</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Doctor not found.</div>
}
