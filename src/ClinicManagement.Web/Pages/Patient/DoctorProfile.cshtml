@page "{doctorId:int}"
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-md me-2"></i>Doctor Profile</h2>
    <a asp-page="/Patient/ViewDoctors" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
</div>

@if (Model.Doctor != null)
{
    <div class="row">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="fas fa-user-md fa-5x text-primary mb-3"></i>
                    <h4>Dr. @Model.Doctor.Name</h4>
                    <p class="text-muted">@Model.Doctor.Specialization</p>
                    <p class="badge bg-primary">@Model.Doctor.DepartmentName</p>
                    <div class="mt-3">
                        <a asp-page="/Patient/TakeAppointment" asp-route-doctorId="@Model.Doctor.DoctorId"
                           class="btn btn-primary">
                            <i class="fas fa-calendar-plus me-1"></i>Book Appointment
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header"><h5 class="mb-0">Professional Details</h5></div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Phone:</strong> @Model.Doctor.Phone</p>
                            <p><strong>Gender:</strong> @Model.Doctor.Gender</p>
                            <p><strong>Age:</strong> @Model.Doctor.Age years</p>
                            <p><strong>Experience:</strong> @Model.Doctor.Experience years</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Qualification:</strong> @Model.Doctor.Qualification</p>
                            <p><strong>Charges/Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
                            <p><strong>Patients Treated:</strong> @Model.Doctor.PatientsTreated</p>
                            <p><strong>Repute Index:</strong> @Model.Doctor.ReputeIndex.ToString("F1")/5.0</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Doctor not found.</div>
}
