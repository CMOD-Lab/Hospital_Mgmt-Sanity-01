@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-user-md me-2"></i>View Doctors by Department</h2>
        <hr />
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get">
            <div class="input-group">
                <select name="dept" class="form-select" asp-items="Model.DepartmentOptions">
                    <option value="">Select Department</option>
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search me-1"></i>View Doctors
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Doctors.Any())
{
    <div class="row">
        @foreach (var doctor in Model.Doctors)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow h-100">
                    <div class="card-header bg-primary text-white">
                        <h6 class="mb-0">Dr. @doctor.Name</h6>
                    </div>
                    <div class="card-body">
                        <p><strong>Specialization:</strong> @doctor.Specialization</p>
                        <p><strong>Qualification:</strong> @doctor.Qualification</p>
                        <p><strong>Experience:</strong> @doctor.Experience years</p>
                        <p><strong>Charges/Visit:</strong> $@doctor.ChargesPerVisit</p>
                        <p><strong>Repute Index:</strong> @doctor.ReputeIndex.ToString("F1")</p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Patient/TakeAppointment" asp-route-doctorId="@doctor.DoctorId" class="btn btn-sm btn-success w-100">
                            <i class="fas fa-calendar-plus me-1"></i>Book Appointment
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(Model.SelectedDept))
{
    <div class="alert alert-info">No doctors found for the selected department.</div>
}
