@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
}

<h2 class="mb-4"><i class="fas fa-user-md me-2"></i>Find a Doctor</h2>

<div class="card mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Select Department</label>
                    <select name="department" class="form-select" onchange="this.form.submit()">
                        <option value="">All Departments</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.DeptName" selected="@(Model.SelectedDepartment == dept.DeptName)">
                                @dept.DeptName
                            </option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @foreach (var doctor in Model.Doctors)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-user-md fa-3x text-primary mb-3"></i>
                    <h5>Dr. @doctor.Name</h5>
                    <p class="text-muted">@doctor.Specialization</p>
                    <p class="text-muted small">@doctor.DepartmentName</p>
                    <p><strong>Charges:</strong> $@doctor.ChargesPerVisit/visit</p>
                    <p><strong>Experience:</strong> @doctor.Experience years</p>
                    <a asp-page="/Patient/DoctorProfile" asp-route-doctorId="@doctor.DoctorId"
                       class="btn btn-outline-primary btn-sm me-1">
                        <i class="fas fa-info-circle me-1"></i>Profile
                    </a>
                    <a asp-page="/Patient/TakeAppointment" asp-route-doctorId="@doctor.DoctorId"
                       class="btn btn-primary btn-sm">
                        <i class="fas fa-calendar-plus me-1"></i>Book
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Doctors.Any())
    {
        <div class="col-12">
            <p class="text-muted text-center">No doctors found.</p>
        </div>
    }
</div>
