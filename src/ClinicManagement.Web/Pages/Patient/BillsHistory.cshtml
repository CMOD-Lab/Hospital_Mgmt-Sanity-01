@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice-dollar me-2"></i>Bills History</h2>
        <hr />
        <a asp-page="/Patient/PatientHome" class="btn btn-secondary mb-3">
            <i class="fas fa-arrow-left me-1"></i>Back to Home
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Appointment ID</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.BillHistory)
                    {
                        <tr>
                            <td>@bill.AppointID</td>
                            <td>@bill.DoctorName</td>
                            <td>@bill.Date</td>
                            <td>$@bill.BillAmount?.ToString("N2")</td>
                            <td>
                                <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                    @bill.BillStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.BillHistory.Any())
        {
            <div class="alert alert-info">No billing history found.</div>
        }
    </div>
</div>
