@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
}

<h2 class="mb-4"><i class="fas fa-file-invoice me-2"></i>Bills History</h2>

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in Model.Bills)
                {
                    <tr>
                        <td>@bill.DoctorName</td>
                        <td>@bill.BillDate.ToString("MMM dd, yyyy")</td>
                        <td>$@bill.Amount.ToString("N2")</td>
                        <td>
                            <span class="badge @(bill.IsPaid ? "bg-success" : "bg-warning")">
                                @(bill.IsPaid ? "Paid" : "Pending")
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Bills.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted">No bills found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
