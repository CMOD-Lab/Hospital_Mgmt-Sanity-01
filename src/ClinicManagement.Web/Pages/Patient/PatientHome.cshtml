@page
@model ClinicManagement.Web.Pages.Patient.PatientHomeModel
@{
    ViewData["Title"] = "Patient Home";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-home me-2"></i>Patient Dashboard</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<!-- Patient Info Card -->
@if (Model.PatientInfo != null)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-user me-2"></i>My Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Name:</strong> @Model.PatientInfo.Name</p>
                    <p><strong>Phone:</strong> @Model.PatientInfo.Phone</p>
                    <p><strong>Gender:</strong> @Model.PatientInfo.Gender</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Birth Date:</strong> @Model.PatientInfo.BirthDate</p>
                    <p><strong>Age:</strong> @Model.PatientInfo.Age years</p>
                    <p><strong>Address:</strong> @Model.PatientInfo.Address</p>
                </div>
            </div>
        </div>
    </div>
}

<!-- Navigation Cards -->
<div class="row">
    <div class="col-md-4 mb-3">
        <a asp-page="/Patient/ViewDoctors" class="text-decoration-none">
            <div class="card border-primary h-100 shadow-sm">
                <div class="card-body text-center py-4">
                    <i class="fas fa-user-md fa-3x text-primary mb-3"></i>
                    <h5>View Doctors</h5>
                    <p class="text-muted small">Browse available doctors by department</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-3">
        <a asp-page="/Patient/CurrentAppointment" class="text-decoration-none">
            <div class="card border-success h-100 shadow-sm">
                <div class="card-body text-center py-4">
                    <i class="fas fa-calendar-check fa-3x text-success mb-3"></i>
                    <h5>Current Appointment</h5>
                    <p class="text-muted small">View your current appointment</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-3">
        <a asp-page="/Patient/TreatmentHistory" class="text-decoration-none">
            <div class="card border-info h-100 shadow-sm">
                <div class="card-body text-center py-4">
                    <i class="fas fa-history fa-3x text-info mb-3"></i>
                    <h5>Treatment History</h5>
                    <p class="text-muted small">View your treatment history</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-3">
        <a asp-page="/Patient/BillsHistory" class="text-decoration-none">
            <div class="card border-warning h-100 shadow-sm">
                <div class="card-body text-center py-4">
                    <i class="fas fa-file-invoice-dollar fa-3x text-warning mb-3"></i>
                    <h5>Bills History</h5>
                    <p class="text-muted small">View your billing history</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-3">
        <a asp-page="/Patient/PatientNotifications" class="text-decoration-none">
            <div class="card border-secondary h-100 shadow-sm">
                <div class="card-body text-center py-4">
                    <i class="fas fa-bell fa-3x text-secondary mb-3"></i>
                    <h5>Notifications</h5>
                    <p class="text-muted small">View your notifications</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-3">
        <a asp-page="/Patient/PatientFeedback" class="text-decoration-none">
            <div class="card border-danger h-100 shadow-sm">
                <div class="card-body text-center py-4">
                    <i class="fas fa-star fa-3x text-danger mb-3"></i>
                    <h5>Feedback</h5>
                    <p class="text-muted small">Submit feedback for your doctor</p>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="mt-3">
    <a asp-page="/SignUp" class="btn btn-outline-danger">
        <i class="fas fa-sign-out-alt me-1"></i>Logout
    </a>
</div>
