@page
@model ClinicManagement.Web.Pages.Patient.TakeAppointmentModel
@{
    ViewData["Title"] = "Take Appointment";
    Layout = "_PatientLayout";
}

<h2 class="mb-4"><i class="fas fa-calendar-plus text-success me-2"></i>Book Appointment</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsSuccess ? "success" : "danger")">@Model.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Select Department</label>
                <select name="deptName" class="form-select" asp-for="SelectedDept" onchange="this.form.submit()">
                    <option value="">-- Select Department --</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DeptName">@dept.DeptName</option>
                    }
                </select>
            </div>

            @if (Model.Doctors.Any())
            {
                <div class="mb-3">
                    <label class="form-label">Select Doctor</label>
                    <select name="doctorId" class="form-select" asp-for="SelectedDoctorId">
                        <option value="0">-- Select Doctor --</option>
                        @foreach (var doc in Model.Doctors)
                        {
                            <option value="@doc.DoctorId">@doc.Name</option>
                        }
                    </select>
                </div>
            }

            @if (Model.FreeSlots.Any())
            {
                <div class="mb-3">
                    <label class="form-label">Available Slots</label>
                    <select name="slotId" class="form-select">
                        @foreach (var slot in Model.FreeSlots)
                        {
                            <option value="@slot.SlotId">@slot.Date.ToString("yyyy-MM-dd") @slot.Timings</option>
                        }
                    </select>
                </div>
                <button type="submit" asp-page-handler="Book" class="btn btn-success">
                    <i class="fas fa-check me-2"></i>Confirm Appointment
                </button>
            }
            else if (!string.IsNullOrEmpty(Model.SelectedDept))
            {
                <div class="alert alert-info">No available slots for the selected doctor.</div>
            }
        </form>
    </div>
</div>
