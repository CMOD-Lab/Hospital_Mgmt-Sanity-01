@page "{doctorId:int}"
@model ClinicManagement.Web.Pages.Patient.TakeAppointmentModel
@{
    ViewData["Title"] = "Take Appointment";
}

<h2 class="mb-4"><i class="fas fa-calendar-plus me-2"></i>Book Appointment</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Doctor != null)
{
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Dr. @Model.Doctor.Name - @Model.Doctor.Specialization</h5>
        </div>
        <div class="card-body">
            <p><strong>Department:</strong> @Model.Doctor.DepartmentName</p>
            <p><strong>Charges per visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
        </div>
    </div>

    @if (Model.FreeSlots.Any())
    {
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Available Time Slots</h5></div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="doctorId" value="@Model.Doctor.DoctorId" />
                    <div class="row">
                        @foreach (var slot in Model.FreeSlots)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="timeSlotId"
                                           id="slot_@slot.TimeSlotId" value="@slot.TimeSlotId" required />
                                    <label class="form-check-label" for="slot_@slot.TimeSlotId">
                                        <i class="fas fa-clock me-1"></i>@slot.Timings
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="fas fa-calendar-check me-1"></i>Book Appointment
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>No available time slots for this doctor.
        </div>
    }
}
