@page
@model ClinicManagement.Web.Pages.Patient.TakeAppointmentModel
@{
    ViewData["Title"] = "Take Appointment";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-calendar-plus me-2"></i>Take Appointment</h2>
        <hr />
        <a asp-page="/Patient/PatientHome" class="btn btn-secondary mb-3">
            <i class="fas fa-arrow-left me-1"></i>Back to Home
        </a>
    </div>
</div>

<!-- Department Selection -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Step 1: Select Department</h5>
    </div>
    <div class="card-body">
        <form method="get">
            <div class="row align-items-end">
                <div class="col-md-8 mb-3">
                    <label class="form-label">Department</label>
                    <select name="deptName" class="form-select" asp-items="Model.DepartmentSelectList">
                        <option value="">Select Department</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>Find Doctors
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Doctors.Any())
{
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Step 2: Select Doctor</h5>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var doctor in Model.Doctors)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <i class="fas fa-user-md fa-3x text-primary mb-2"></i>
                                <h6>@doctor.Name</h6>
                                <p class="text-muted small">@doctor.Department</p>
                                <a asp-page="/Patient/AppointmentTaker" asp-route-doctorId="@doctor.DoctorID" class="btn btn-success btn-sm">
                                    Book Appointment
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
