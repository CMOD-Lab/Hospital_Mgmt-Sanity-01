@page
@model ClinicManagement.Web.Pages.Patient.FeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
    Layout = "_PatientLayout";
}

<h2 class="mb-4"><i class="fas fa-star text-warning me-2"></i>Patient Feedback</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsSuccess ? "success" : "info")">@Model.Message</div>
}

@if (Model.PendingFeedback != null)
{
    <div class="card shadow">
        <div class="card-header bg-warning">
            <h5 class="mb-0">Pending Feedback</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.PendingFeedback.DoctorName</p>
            <p><strong>Appointment Time:</strong> @Model.PendingFeedback.Timings</p>
            <form method="post">
                <input type="hidden" name="appointId" value="@Model.PendingFeedback.AppointId" />
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-star me-2"></i>Submit Feedback
                </button>
            </form>
        </div>
    </div>
}
else if (string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">No pending feedback at this time.</div>
}
