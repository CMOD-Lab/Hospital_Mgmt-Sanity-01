@page
@model ClinicManagement.Web.Pages.Admin.ManageStaffModel
@{
    ViewData["Title"] = "Manage Staff";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h2><i class="fas fa-users me-2"></i>Manage Staff</h2>
    </div>
    <div class="col-md-4 text-end">
        <a asp-page="/Admin/AddStaff" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Add Staff
        </a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search staff by name..." />
                <button type="submit" class="btn btn-outline-primary"><i class="fas fa-search"></i> Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a asp-page="/Admin/ManageStaff" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Designation</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model.StaffList)
                {
                    <tr>
                        <td>@staff.StaffId</td>
                        <td>@staff.Name</td>
                        <td>@staff.Designation</td>
                        <td>@staff.Phone</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="id" value="@staff.StaffId" />
                                <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Remove this staff member?')">
                                    <i class="fas fa-trash"></i> Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.StaffList.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No staff found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
