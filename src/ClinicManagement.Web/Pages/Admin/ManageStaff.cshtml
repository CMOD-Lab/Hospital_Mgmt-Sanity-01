@page
@model ClinicManagement.Web.Pages.Admin.ManageStaffModel
@{
    ViewData["Title"] = "Manage Staff";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-id-badge me-2"></i>Manage Staff</h2>
    <a asp-page="/Admin/AddStaff" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add Staff
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Designation</th>
                    <th>Phone</th>
                    <th>Salary</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model.StaffList)
                {
                    <tr>
                        <td>@staff.StaffId</td>
                        <td>@staff.Name</td>
                        <td>@staff.Designation</td>
                        <td>@staff.Phone</td>
                        <td>$@staff.Salary.ToString("N2")</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="id" value="@staff.StaffId" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Remove this staff member?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.StaffList.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No staff found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
