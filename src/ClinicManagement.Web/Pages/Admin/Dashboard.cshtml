@page
@model ClinicManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
        <p class="text-muted">Welcome, @HttpContext.Session.GetString("UserName")</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Doctors</h6>
                        <h2 class="mb-0">@Model.Dashboard?.TotalDoctors</h2>
                    </div>
                    <i class="fas fa-user-md fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Patients</h6>
                        <h2 class="mb-0">@Model.Dashboard?.TotalPatients</h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Income</h6>
                        <h2 class="mb-0">$@Model.Dashboard?.TotalIncome.ToString("N2")</h2>
                    </div>
                    <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-building me-2"></i>Departments</h5>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Doctors</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in Model.Dashboard?.Departments ?? Enumerable.Empty<ClinicManagement.Application.DTOs.DepartmentDto>())
                        {
                            <tr>
                                <td>@dept.DeptName</td>
                                <td><span class="badge bg-primary">@dept.DoctorCount</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Recent Appointments</h5>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Dashboard?.RecentAppointments ?? Enumerable.Empty<ClinicManagement.Application.DTOs.AppointmentDto>())
                        {
                            <tr>
                                <td>@appt.PatientName</td>
                                <td>@appt.DoctorName</td>
                                <td>
                                    <span class="badge @(appt.Status == "Approved" ? "bg-success" : appt.Status == "Pending" ? "bg-warning" : "bg-secondary")">
                                        @appt.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-tools me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <a asp-page="/Admin/AddDoctor" class="btn btn-primary me-2">
                    <i class="fas fa-user-md me-1"></i>Add Doctor
                </a>
                <a asp-page="/Admin/AddStaff" class="btn btn-success me-2">
                    <i class="fas fa-user-plus me-1"></i>Add Staff
                </a>
                <a asp-page="/Admin/ManageDoctors" class="btn btn-info me-2">
                    <i class="fas fa-list me-1"></i>Manage Doctors
                </a>
                <a asp-page="/Admin/ManagePatients" class="btn btn-warning me-2">
                    <i class="fas fa-users me-1"></i>Manage Patients
                </a>
                <a asp-page="/Admin/ManageStaff" class="btn btn-secondary">
                    <i class="fas fa-id-badge me-1"></i>Manage Staff
                </a>
            </div>
        </div>
    </div>
</div>
