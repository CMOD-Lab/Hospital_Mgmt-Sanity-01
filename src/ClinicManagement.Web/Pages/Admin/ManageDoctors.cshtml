@page
@model ClinicManagement.Web.Pages.Admin.ManageDoctorsModel
@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-md me-2"></i>Manage Doctors</h2>
    <a asp-page="/Admin/AddDoctor" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add Doctor
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search doctors by name..." />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-search me-1"></i>Search
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a asp-page="/Admin/ManageDoctors" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>

        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Specialization</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model.Doctors)
                {
                    <tr>
                        <td>@doctor.DoctorId</td>
                        <td>@doctor.Name</td>
                        <td>@doctor.DepartmentName</td>
                        <td>@doctor.Specialization</td>
                        <td>@doctor.Phone</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="id" value="@doctor.DoctorId" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Are you sure you want to remove this doctor?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Doctors.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No doctors found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
