@page
@model ClinicManagement.Web.Pages.Admin.ManageDoctorsModel
@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="row mb-3">
    <div class="col-md-8">
        <h2><i class="fas fa-user-md me-2"></i>Manage Doctors</h2>
    </div>
    <div class="col-md-4 text-end">
        <a asp-page="/Admin/AddDoctor" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Add Doctor
        </a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search doctors by name..." />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-search"></i> Search
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a asp-page="/Admin/ManageDoctors" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show">
                @Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model.Doctors)
                {
                    <tr>
                        <td>@doctor.DoctorId</td>
                        <td>@doctor.Name</td>
                        <td>@doctor.DepartmentName</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="id" value="@doctor.DoctorId" />
                                <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to remove this doctor?')">
                                    <i class="fas fa-trash"></i> Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Doctors.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted">No doctors found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
