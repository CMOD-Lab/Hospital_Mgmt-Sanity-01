@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-history me-2"></i>Previous Patient History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Disease</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.Appointments)
                {
                    <tr>
                        <td>@appt.AppointmentId</td>
                        <td>@appt.PatientName</td>
                        <td>@appt.AppointmentDate.ToString("yyyy-MM-dd")</td>
                        <td>@(appt.Disease ?? "N/A")</td>
                        <td>
                            <span class="badge @(appt.Status == ClinicManagement.Domain.Enums.AppointmentStatus.Completed ? "bg-success" : "bg-secondary")">
                                @appt.Status
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Appointments.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No history found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
