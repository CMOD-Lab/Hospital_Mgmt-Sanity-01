@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentsModel
@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "_DoctorLayout";
}

<h2 class="mb-4"><i class="fas fa-clock text-warning me-2"></i>Pending Appointments</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsSuccess ? "success" : "danger")">@Model.Message</div>
}

@if (Model.Appointments.Any())
{
    <div class="card shadow">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Appointment ID</th>
                        <th>Patient Name</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.Appointments)
                    {
                        <tr>
                            <td>@appt.AppointId</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Date?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-warning text-dark">@appt.Status</span></td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="appointId" value="@appt.AppointId" />
                                    <button type="submit" asp-page-handler="Approve" class="btn btn-success btn-sm">
                                        <i class="fas fa-check"></i> Approve
                                    </button>
                                    <button type="submit" asp-page-handler="Reject" class="btn btn-danger btn-sm ms-1">
                                        <i class="fas fa-times"></i> Reject
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">No pending appointments.</div>
}
