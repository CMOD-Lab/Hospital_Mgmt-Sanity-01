@page "{id:int}"
@model ClinicManagement.Web.Pages.Doctor.UpdateHistoryModel
@{
    ViewData["Title"] = "Update Patient History";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-edit me-2"></i>Update Patient History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">@Model.SuccessMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        <form method="post">
            <input type="hidden" asp-for="AppointmentId" />
            <div class="mb-3">
                <label asp-for="Input.Disease" class="form-label">Disease / Diagnosis</label>
                <input asp-for="Input.Disease" class="form-control" placeholder="Enter diagnosis" />
                <span asp-validation-for="Input.Disease" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Progress" class="form-label">Progress</label>
                <textarea asp-for="Input.Progress" class="form-control" rows="3" placeholder="Enter progress notes"></textarea>
                <span asp-validation-for="Input.Progress" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Prescription" class="form-label">Prescription</label>
                <textarea asp-for="Input.Prescription" class="form-control" rows="3" placeholder="Enter prescription"></textarea>
                <span asp-validation-for="Input.Prescription" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Save
                </button>
                <a asp-page="/Doctor/PatientHistory" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>
