@page "{appointmentId:int?}"
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update Patient History";
}

<h2 class="mb-4"><i class="fas fa-edit me-2"></i>Update Patient History</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsError ? "danger" : "success") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Appointment != null)
{
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Appointment Details</h5>
        </div>
        <div class="card-body">
            <p><strong>Patient:</strong> @Model.Appointment.PatientName</p>
            <p><strong>Time:</strong> @Model.Appointment.Timings</p>
            <p><strong>Date:</strong> @Model.Appointment.AppointmentDate.ToString("MMM dd, yyyy")</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="AppointmentId" />
                <div class="mb-3">
                    <label asp-for="Disease" class="form-label">Disease / Diagnosis</label>
                    <input asp-for="Disease" class="form-control" placeholder="Enter diagnosis" />
                    <span asp-validation-for="Disease" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Progress" class="form-label">Progress Notes</label>
                    <textarea asp-for="Progress" class="form-control" rows="3" placeholder="Enter progress notes"></textarea>
                    <span asp-validation-for="Progress" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Prescription" class="form-label">Prescription</label>
                    <textarea asp-for="Prescription" class="form-control" rows="3" placeholder="Enter prescription"></textarea>
                    <span asp-validation-for="Prescription" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Save & Complete
                    </button>
                    <a asp-page="/Doctor/Home" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Appointment not found.</div>
}
