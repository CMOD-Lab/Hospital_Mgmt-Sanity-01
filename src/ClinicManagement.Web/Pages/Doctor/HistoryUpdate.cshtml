@page
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update History";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-edit me-2"></i>Update Patient History</h2>
        <hr />
        <a asp-page="/Doctor/DoctorHome" class="btn btn-secondary mb-3">
            <i class="fas fa-arrow-left me-1"></i>Back to Home
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Today's Appointments</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.TodaysAppointments)
                    {
                        <tr>
                            <td>@appt.AppointID</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Date</td>
                            <td>@appt.Disease</td>
                            <td>@appt.Progress</td>
                            <td>@appt.Prescription</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-primary"
                                        data-bs-toggle="modal" data-bs-target="#updateModal"
                                        data-appoint-id="@appt.AppointID"
                                        data-disease="@appt.Disease"
                                        data-progress="@appt.Progress"
                                        data-prescription="@appt.Prescription">
                                    <i class="fas fa-edit"></i> Update
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.TodaysAppointments.Any())
        {
            <div class="alert alert-info">No appointments today.</div>
        }
    </div>
</div>

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Prescription</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <input type="hidden" id="appointmentId" name="appointmentId" />
                    <div class="mb-3">
                        <label class="form-label">Disease</label>
                        <input type="text" id="disease" name="disease" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Progress</label>
                        <input type="text" id="progress" name="progress" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prescription</label>
                        <input type="text" id="prescription" name="prescription" class="form-control" maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('updateModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('appointmentId').value = button.getAttribute('data-appoint-id');
            document.getElementById('disease').value = button.getAttribute('data-disease') || '';
            document.getElementById('progress').value = button.getAttribute('data-progress') || '';
            document.getElementById('prescription').value = button.getAttribute('data-prescription') || '';
        });
    </script>
}
