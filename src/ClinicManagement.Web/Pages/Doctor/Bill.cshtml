@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Generate Bills";
    Layout = "_DoctorLayout";
}

<h2 class="mb-4"><i class="fas fa-file-invoice-dollar text-success me-2"></i>Generate Bills</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsSuccess ? "success" : "danger")">@Model.Message</div>
}

@if (Model.Bills.Any())
{
    <div class="card shadow">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Appointment ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.Bills)
                    {
                        <tr>
                            <td>@bill.AppointId</td>
                            <td>@bill.PatientName</td>
                            <td>@bill.Date?.ToString("yyyy-MM-dd")</td>
                            <td>Rs. @bill.BillAmount?.ToString("F2")</td>
                            <td>
                                <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-danger")">
                                    @(bill.BillStatus ?? "Pending")
                                </span>
                            </td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="appointId" value="@bill.AppointId" />
                                    <button type="submit" asp-page-handler="MarkPaid" class="btn btn-success btn-sm">
                                        <i class="fas fa-check"></i> Paid
                                    </button>
                                    <button type="submit" asp-page-handler="MarkUnpaid" class="btn btn-danger btn-sm ms-1">
                                        <i class="fas fa-times"></i> Unpaid
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">No bills to display.</div>
}
