@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Generate Bills";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice-dollar me-2"></i>Generate Bills</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in Model.Bills)
                {
                    <tr>
                        <td>@bill.PatientName</td>
                        <td>@bill.BillDate.ToString("yyyy-MM-dd")</td>
                        <td>$@bill.Amount.ToString("N2")</td>
                        <td>
                            <span class="badge @(bill.Status == ClinicManagement.Domain.Enums.BillStatus.Paid ? "bg-success" : bill.Status == ClinicManagement.Domain.Enums.BillStatus.Unpaid ? "bg-danger" : "bg-warning")">
                                @bill.Status
                            </span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="MarkPaid" class="d-inline">
                                <input type="hidden" name="appointmentId" value="@bill.AppointmentId" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="fas fa-check"></i> Paid
                                </button>
                            </form>
                            <form method="post" asp-page-handler="MarkUnpaid" class="d-inline">
                                <input type="hidden" name="appointmentId" value="@bill.AppointmentId" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-times"></i> Unpaid
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Bills.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No bills found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
