@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Billing";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice-dollar me-2"></i>Billing</h2>
        <hr />
        <a asp-page="/Doctor/DoctorHome" class="btn btn-secondary mb-3">
            <i class="fas fa-arrow-left me-1"></i>Back to Home
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.BillableAppointments)
                    {
                        <tr>
                            <td>@bill.AppointID</td>
                            <td>@bill.PatientName</td>
                            <td>@bill.Date</td>
                            <td>$@bill.BillAmount?.ToString("N2")</td>
                            <td>
                                <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                    @(bill.BillStatus ?? "Pending")
                                </span>
                            </td>
                            <td>
                                <form method="post" asp-page-handler="MarkPaid" class="d-inline">
                                    <input type="hidden" name="appointmentId" value="@bill.AppointID" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="fas fa-check"></i> Paid
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="MarkUnpaid" class="d-inline">
                                    <input type="hidden" name="appointmentId" value="@bill.AppointID" />
                                    <button type="submit" class="btn btn-sm btn-warning">
                                        <i class="fas fa-times"></i> Unpaid
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.BillableAppointments.Any())
        {
            <div class="alert alert-info">No billable appointments found.</div>
        }
    </div>
</div>
