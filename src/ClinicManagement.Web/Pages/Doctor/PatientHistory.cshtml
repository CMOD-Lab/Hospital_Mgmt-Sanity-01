@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Patient History";
    Layout = "_DoctorLayout";
}

<h2 class="mb-4"><i class="fas fa-history text-info me-2"></i>Patient History</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsSuccess ? "success" : "danger")">@Model.Message</div>
}

@if (Model.TodayAppointments.Any())
{
    <h4 class="mb-3">Today's Appointments</h4>
    <div class="card shadow mb-4">
        <div class="card-body">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Appointment ID</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th>Disease</th>
                        <th>Progress</th>
                        <th>Prescription</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.TodayAppointments)
                    {
                        <tr>
                            <td>@appt.AppointId</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Date?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@appt.Disease</td>
                            <td>@appt.Progress</td>
                            <td>@appt.Prescription</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal"
                                        data-bs-target="#prescriptionModal"
                                        data-appoint-id="@appt.AppointId">
                                    <i class="fas fa-edit"></i> Update
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">No appointments today.</div>
}

<!-- Prescription Update Modal -->
<div class="modal fade" id="prescriptionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Prescription</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdatePrescription">
                <div class="modal-body">
                    <input type="hidden" id="appointId" name="appointId" />
                    <div class="mb-3">
                        <label class="form-label">Disease</label>
                        <input type="text" name="disease" class="form-control" maxlength="30" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Progress</label>
                        <input type="text" name="progress" class="form-control" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prescription</label>
                        <input type="text" name="prescription" class="form-control" maxlength="60" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('prescriptionModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var appointId = button.getAttribute('data-appoint-id');
            document.getElementById('appointId').value = appointId;
        });
    </script>
}
