@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Patient History";
}

<h2 class="mb-4"><i class="fas fa-history me-2"></i>Patient History</h2>

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Disease</th>
                    <th>Prescription</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.Appointments)
                {
                    <tr>
                        <td>@appt.PatientName</td>
                        <td>@appt.AppointmentDate.ToString("MMM dd, yyyy")</td>
                        <td>@(appt.Disease ?? "-")</td>
                        <td>@(appt.Prescription ?? "-")</td>
                        <td>
                            <span class="badge @(appt.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                @appt.Status
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Appointments.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No patient history found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
