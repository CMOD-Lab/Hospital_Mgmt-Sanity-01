@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Today's Patients";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-stethoscope me-2"></i>Today's Patients</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Patient Name</th>
                    <th>Timings</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.Appointments)
                {
                    <tr>
                        <td>@appt.AppointmentId</td>
                        <td>@appt.PatientName</td>
                        <td>@appt.Timings</td>
                        <td>
                            <a asp-page="/Doctor/UpdateHistory" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-primary">
                                <i class="fas fa-edit"></i> Update
                            </a>
                            <a asp-page="/Doctor/Bill" asp-route-doctorId="@appt.DoctorId" class="btn btn-sm btn-warning">
                                <i class="fas fa-file-invoice-dollar"></i> Bill
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Appointments.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted">No appointments today.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
