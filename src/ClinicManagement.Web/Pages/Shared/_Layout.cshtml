<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-hospital-alt me-2"></i>Clinic Management System
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        var userType = Context.Session.GetInt32("UserType");
                        if (userType == 0)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/ManageDoctors">Doctors</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/ManageStaff">Staff</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/ManagePatients">Patients</a></li>
                        }
                        else if (userType == 1)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Doctor/Home">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Doctor/PendingAppointments">Appointments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Doctor/PatientHistory">History</a></li>
                        }
                        else if (userType == 2)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Patient/Home">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Patient/ViewDoctors">Doctors</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Patient/CurrentAppointment">Appointment</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Patient/BillsHistory">Bills</a></li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Account/Logout">
                                <i class="fas fa-sign-out-alt me-1"></i>Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Account/SignUp">Sign Up</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="footer mt-5 py-3 bg-dark text-white">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year Clinic Management System. All rights reserved.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
